{
	"name": "todo-manager",
	"version": "0.1.0",
	"description": "Obsidian plugin that moves completed tasks into a collapsible callout at the end of their own list.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"todo",
		"tasks"
	],
	"author": "wenzel1983",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EKataskin/obsidian-todo-manager.git"
	},
	"bugs": {
		"url": "https://github.com/EKataskin/obsidian-todo-manager/issues"
	},
	"homepage": "https://github.com/EKataskin/obsidian-todo-manager#readme",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"esbuild": "^0.20.2",
		"obsidian": "latest",
		"tslib": "^2.6.2",
		"typescript": "^5.4.5",
		"vitest": "^1.6.0"
	}
}
